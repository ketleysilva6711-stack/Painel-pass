# .env.production.template - Template para Produção
# Copie para .env.production e preencha TODOS os valores
# NUNCA commite este arquivo com valores reais!

# =============================================================================
# APPLICATION
# =============================================================================
APP_NAME="The Vault Panel"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://seu-dominio.com
APP_TIMEZONE=America/Sao_Paulo

# IMPORTANTE: Gere com: php artisan key:generate --show
APP_KEY=base64:SUA_CHAVE_AQUI_32_CARACTERES_BASE64

# =============================================================================
# DATABASE (MySQL 8.0)
# =============================================================================
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=the_vault
DB_USERNAME=the_vault
DB_PASSWORD=SUA_SENHA_MYSQL_SEGURA_AQUI
DB_ROOT_PASSWORD=SUA_SENHA_ROOT_MYSQL_SEGURA_AQUI

# =============================================================================
# REDIS
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=SUA_SENHA_REDIS_SEGURA_AQUI
REDIS_DB=0

# =============================================================================
# CACHE / SESSION / QUEUE
# =============================================================================
CACHE_DRIVER=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

# =============================================================================
# SANCTUM / JWT
# =============================================================================
# IMPORTANTE: Gere com: openssl rand -base64 32
JWT_SECRET=SUA_CHAVE_JWT_32_CARACTERES_BASE64_AQUI_MUITO_SEGURA
SANCTUM_STATEFUL_DOMAINS=seu-dominio.com,www.seu-dominio.com
SESSION_DOMAIN=seu-dominio.com

# =============================================================================
# MAIL (SMTP)
# =============================================================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=seu-email@gmail.com
MAIL_PASSWORD=SUA_SENHA_APP_GMAIL_AQUI
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@seu-dominio.com
MAIL_FROM_NAME="The Vault Panel"

# =============================================================================
# STORAGE / FILESYSTEM
# =============================================================================
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
# VITE / FRONTEND
# =============================================================================
VITE_API_URL=https://seu-dominio.com/api
VITE_APP_NAME="The Vault Panel"

# =============================================================================
# BACKUP / S3 / MINIO
# =============================================================================
BACKUP_RETENTION_DAYS=30
BACKUP_S3_ENABLED=false
BACKUP_S3_BUCKET=seu-bucket-backups
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ENDPOINT=
AWS_ACCESS_KEY_ID_BACKUP=
AWS_SECRET_ACCESS_KEY_BACKUP=

# =============================================================================
# MONITORING / LOGGING
# =============================================================================
LOG_CHANNEL=stderr
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null
LOG_DEPRECATIONS_TRACE=false

# =============================================================================
# TELESCOPE / DEBUG (DESABILITAR EM PRODUÇÃO)
# =============================================================================
TELESCOPE_ENABLED=false

# =============================================================================
# TOTP / 2FA
# =============================================================================
TOTP_ISSUER="The Vault Panel"
TOTP_WINDOW=1

# =============================================================================
# DOMAIN / SSL
# =============================================================================
DOMAIN=seu-dominio.com
SSL_EMAIL=admin@seu-dominio.com

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_API=60
RATE_LIMIT_LOGIN=5
RATE_LIMIT_UPLOAD=10

# =============================================================================
# APK / BYPASS
# =============================================================================
APK_MAX_SIZE=104857600
APK_ALLOWED_MIME_TYPES=application/vnd.android.package-archive,application/zip
KEYSTORE_PASSWORD=vault2024
KEYSTORE_ALIAS=thevault

# =============================================================================
# FRONTEND (Vercel)
# =============================================================================
VITE_API_URL=https://seu-dominio.com/api
VITE_WS_URL=wss://seu-dominio.com